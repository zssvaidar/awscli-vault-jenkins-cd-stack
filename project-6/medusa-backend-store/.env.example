# Read automatically by `docker compose` — must sit next to docker-compose.yml
# Change DB name/user/password/ports here; docker-compose.yml picks them up.

# --- Postgres ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
POSTGRES_HOST=
POSTGRES_SCHEMA=
DATABASE_URL=postgres://user:password@host:5432/database
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# --- Redis ---
REDIS_PORT=6379

# --- Medusa backend ---
NODE_ENV=development
MEDUSA_PORT=9000
MEDUSA_ADMIN_PORT=5173

# --- Storefront ---
STOREFRONT_PORT=8000